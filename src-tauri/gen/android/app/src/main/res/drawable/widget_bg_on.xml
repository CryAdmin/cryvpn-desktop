<?xml version="1.0" encoding="utf-8"?>
<!-- Подложка виджета: объёмная плитка с бликом по верхнему краю. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F2175A33" android:centerColor="#F20F1F18" android:endColor="#F207090D" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#804ADE80" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#24FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
