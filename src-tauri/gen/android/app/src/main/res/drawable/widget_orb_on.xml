<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка-шар виджета, VPN включён: свечение, шар с бликом, голова робота. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="32dp"
                android:startColor="#B34ADE80" android:centerColor="#404ADE80" android:endColor="#004ADE80" />
        </shape>
    </item>
    <item android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:centerX="0.36" android:centerY="0.28" android:gradientRadius="34dp"
                android:startColor="#FFD1FADF" android:centerColor="#FF2FD06F" android:endColor="#FF0A6B33" />
            <stroke android:width="1dp" android:color="#CCBBF7D0" />
        </shape>
    </item>
    <item android:bottom="34dp" android:left="17dp" android:right="17dp" android:top="11dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#99FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:bottom="19dp" android:left="19dp" android:right="19dp" android:top="18dp"
        android:drawable="@drawable/widget_robot_on" />
</layer-list>
