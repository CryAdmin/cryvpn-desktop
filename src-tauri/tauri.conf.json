{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CryVPN",
  "version": "0.1.16",
  "identifier": "top.cryvpn.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CryVPN",
        "width": 700,
        "height": 990,
        "minWidth": 600,
        "minHeight": 760,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CryVPN",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cryvpn"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "cryvpn"
          ],
          "host": "add"
        },
        {
          "scheme": [
            "cryvpn"
          ],
          "host": "login"
        }
      ]
    }
  }
}
