{
  "app": {
    "windows": [
      {
        "title": "CryVPN",
        "width": 600,
        "height": 880,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "CryVPN",
    "longDescription": "VPN-клиент CryVPN",
    "resources": {
      "resources-linux/xray": "resources/xray",
      "resources-linux/geoip.dat": "resources/geoip.dat",
      "resources-linux/geosite.dat": "resources/geosite.dat"
    },
    "linux": {
      "deb": {
        "depends": [
          "pkexec | policykit-1",
          "iproute2",
          "util-linux",
          "libcap2-bin"
        ],
        "postInstallScript": "../scripts/linux-postinst.sh",
        "files": {
          "/usr/lib/CryVPN/cryvpn-dns": "../scripts/linux-cryvpn-dns.sh",
          "/usr/share/polkit-1/actions/top.cryvpn.app.policy": "../scripts/linux-polkit.policy"
        }
      },
      "rpm": {
        "depends": [
          "polkit",
          "iproute",
          "util-linux",
          "libcap"
        ],
        "postInstallScript": "../scripts/linux-postinst.sh",
        "files": {
          "/usr/lib/CryVPN/cryvpn-dns": "../scripts/linux-cryvpn-dns.sh",
          "/usr/share/polkit-1/actions/top.cryvpn.app.policy": "../scripts/linux-polkit.policy"
        }
      }
    }
  }
}
